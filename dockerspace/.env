# dockerspace/.env — non-secret settings for docker compose and the host scripts.
# GO_IMAGE     the dev image's base (the Go toolchain) — pinned, pulled once, kept offline
# TEST_IMAGES  clean Linux images a release is tested in (host_scripts/test_release.sh),
#              each run with networking OFF to prove an offline install + run
GO_IMAGE=golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437
TEST_IMAGES="ubuntu:24.04 debian:12-slim fedora:41"
